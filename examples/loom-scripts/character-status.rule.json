{
  "name": "Character Status Marker",
  "owner": { "kind": "card", "cardId": "tutorial.character.alice" },
  "enabled": true,
  "orderIndex": 100,
  "matcher": {
    "kind": "regex",
    "pattern": "<CharacterStatus>(?<body>[\\s\\S]*?)</CharacterStatus>",
    "flags": "g"
