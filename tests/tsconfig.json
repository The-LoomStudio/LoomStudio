      "@loom-studio/shared": ["../packages/shared/src/index.ts"],
      "@loom-studio/trace-audit": ["../packages/trace-audit/src/index.ts"],
      "@loom-studio/transport": ["../packages/transport/src/index.ts"],
      "@loom/core": ["../packages/core/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
