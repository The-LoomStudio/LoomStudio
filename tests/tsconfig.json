{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@loom-studio/agent-store": ["../packages/agent-store/src/index.ts"],
      "@loom-studio/asset-store": ["../packages/asset-store/src/index.ts"],
