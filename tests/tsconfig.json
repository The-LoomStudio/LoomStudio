      "@loom-studio/client-bridge": ["../packages/client-bridge/src/index.ts"],
      "@loom-studio/data-engine": ["../packages/data-engine/src/index.ts"],
      "@loom-studio/diagnostics": ["../packages/diagnostics/src/index.ts"],
      "@loom-studio/document-store": ["../packages/document-store/src/index.ts"],
      "@loom-studio/application-runtime": ["../packages/application-runtime/src/index.ts"],
      "@loom-studio/extension-host": ["../packages/extension-sdk/extension-host/src/index.ts"],
      "@loom-studio/extension-sdk": ["../packages/extension-sdk/src/index.ts"],
      "@loom-studio/kernel": ["../packages/kernel/src/index.ts"],
