{
  "schemaVersion": 4,
  "artifactId": "loom-city-v0",
  "displayName": "Loom City",
  "description": "Canonical Prompt Builder demo workspace. Artifact is only a seed and distribution boundary; imported SQL workspace documents are the editable runtime state.",
  "card": {
    "name": "雨线车站",
    "userName": "旅人",
    "description": "Loom City 中一座只在雨夜显现的车站。它用于测试 Prompt Builder 的导入、编辑、排序、预览和导出闭环。",
    "macros": {
      "loom.city.name": "Loom City",
      "loom.city.location": "雨线车站"
    },
    "preset": {
      "system": "你是 Loom City 的叙事代理。保持都市奇幻、轻微悬疑和第二人称叙事。"
    },
    "opening": {
      "entries": [
        {
          "role": "assistant",
          "content": "雨线车站的月台灯逐盏亮起，广播里传来一段被雨声切碎的报站。"
        }
      ]
    },
    "settingLayer": {
      "entries": [
        {
          "id": "rainline-station",
          "path": "city.zone.rainline-station",
          "title": "雨线车站",
          "content": "雨线车站只在整点暴雨中显现，候车厅的钟永远慢三分钟。",
          "enabled": true,
          "activation": { "kind": "always" },
          "tags": ["city", "station"]
        },
        {
          "id": "archive-keeper",
          "path": "city.npc.archive-keeper",
          "title": "档案管理员",
          "content": "档案管理员记得每一张被撕毁的车票，也记得它们原本要去往哪里。",
          "enabled": true,
          "activation": { "kind": "keyword", "keywords": ["档案", "车票", "管理员"] },
          "tags": ["city", "npc"]
        }
      ]
    }
  },
  "contextAssets": [
    {
      "id": "preset-default-airp",
      "label": "Default AIRP Preset",
      "meta": "Composition Skeleton",
      "category": "preset",
      "kind": "module",
      "body": "Preset 负责结构、挂载点和默认排序；内容由 Source 通过 Capability 注入。",
      "children": [
        {
          "id": "projection-order-profile-main",
          "label": "Main Projection Order",
          "meta": "Projection Order Profile",
          "category": "preset",
          "kind": "order",
          "body": "主排序覆盖层。编辑它只改变 SQL workspace 中的排序 profile，不会回写原始 artifact。",
          "orderList": [
            "preset-style-directive",
            "sl-rainline-station",
            "sl-archive-keeper",
            "vs-narrative-history",
            "vs-current-input"
          ],
          "slotRanks": [
            {
              "zoneId": "preset.system",
              "slotKey": "preset:preset-default-airp@preset.system",
              "rankKey": "0000"
            },
            {
              "zoneId": "setting.stable",
              "slotKey": "setting-layer:city-layers-main@setting.stable",
              "rankKey": "0001"
            },
            {
              "zoneId": "chat.history",
              "slotKey": "narrative-chat:session-main@chat.history",
              "rankKey": "0002"
            },
            {
              "zoneId": "chat.inside",
              "slotKey": "runtime:runtime.current-turn@chat.inside",
              "rankKey": "0003"
            }
          ]
        },
        {
          "id": "preset-style-directive",
          "label": "叙事风格",
          "meta": "preset.system",
          "category": "preset",
          "kind": "entry",
          "body": "使用清晰、克制、带有雨夜城市感的描写。不要提前解释全部谜底。",
          "enabled": true,
          "capabilities": {
            "projection": {
              "zoneId": "preset.system",
              "slotKey": "preset:preset-default-airp@preset.system",
              "entryOrderHint": 10,
              "slotOrderHint": 100
            }
          }
        }
      ]
    },
    {
      "id": "setting-city-layers",
      "label": "Loom City Layers",
      "meta": "Setting Layer",
      "category": "setting",
      "kind": "module",
      "body": "Setting Layer 作为整体 slot 注入，单个条目只参与 slot 内部排序。",
      "children": [
        {
          "id": "sl-rainline-station",
          "label": "雨线车站",
          "meta": "setting.stable",
          "category": "setting",
          "kind": "entry",
          "body": "雨线车站只在整点暴雨中显现，候车厅的钟永远慢三分钟。",
          "enabled": true,
          "capabilities": {
            "activation": { "kind": "always" },
            "projection": {
              "zoneId": "setting.stable",
              "slotKey": "setting-layer:city-layers-main@setting.stable",
              "entryOrderHint": 10,
              "slotOrderHint": 200
            }
          }
        },
        {
          "id": "sl-archive-keeper",
          "label": "档案管理员",
          "meta": "setting.stable",
          "category": "setting",
          "kind": "entry",
          "body": "档案管理员记得每一张被撕毁的车票，也记得它们原本要去往哪里。",
          "enabled": true,
          "capabilities": {
            "activation": { "kind": "keyword", "keywords": ["档案", "车票", "管理员"] },
            "projection": {
              "zoneId": "setting.stable",
              "slotKey": "setting-layer:city-layers-main@setting.stable",
              "entryOrderHint": 20,
              "slotOrderHint": 200
            }
          }
        }
      ]
    }
  ],
  "state": {
    "kind": "loom.state",
    "schemaVersion": 1,
    "contribution": {
      "id": "loom.city.state",
      "entityTypes": [
        {
          "id": "character",
          "collectionPath": "entities.characters",
          "label": "角色"
        },
        {
          "id": "item",
          "collectionPath": "entities.items",
          "label": "物品"
        }
      ],
      "templates": [
        {
          "id": "loom.example.character.identity",
          "templateVersion": 1,
          "componentKey": "identity",
          "targetEntityTypeIds": ["character"],
          "label": "角色身份",
          "schema": {
            "type": "object",
            "properties": {
              "displayName": { "type": "string" },
              "role": { "type": "string" },
              "present": { "type": "boolean" }
            },
            "required": ["displayName", "role", "present"],
            "additionalProperties": false
          },
          "initial": {
            "displayName": "Unknown Character",
            "role": "visitor",
            "present": true
          }
        },
        {
          "id": "loom.example.character.vitals",
          "templateVersion": 1,
          "componentKey": "vitals",
          "targetEntityTypeIds": ["character"],
          "label": "生命状态",
          "schema": {
            "type": "object",
            "properties": {
              "hp": { "type": "number", "minimum": 0 },
              "maxHp": { "type": "number", "minimum": 1 },
              "status": { "type": "string" }
            },
            "required": ["hp", "maxHp", "status"],
            "additionalProperties": false
          },
          "initial": {
            "hp": 100,
            "maxHp": 100,
            "status": "healthy"
          }
        },
        {
          "id": "loom.example.character.inventory",
          "templateVersion": 1,
          "componentKey": "inventory",
          "targetEntityTypeIds": ["character"],
          "label": "背包",
          "schema": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "x-loom-entity-ref": { "allowedTypeIds": ["item"] }
                }
              }
            },
            "required": ["items"],
            "additionalProperties": false
          },
          "initial": { "items": [] }
        },
        {
          "id": "loom.example.item.identity",
          "templateVersion": 1,
          "componentKey": "identity",
          "targetEntityTypeIds": ["item"],
          "label": "物品身份",
          "schema": {
            "type": "object",
            "properties": {
              "displayName": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["displayName", "description"],
            "additionalProperties": false
          },
          "initial": {
            "displayName": "Unknown Item",
            "description": ""
          }
        }
      ],
      "entities": [
        { "typeId": "character", "entityId": "archive_keeper" },
        { "typeId": "character", "entityId": "night_conductor" },
        { "typeId": "item", "entityId": "rainline-key" }
      ],
      "componentMounts": [
        {
          "templateId": "loom.example.character.identity",
          "templateVersion": 1,
          "componentKey": "identity",
          "target": {
            "kind": "entity",
            "entity": { "typeId": "character", "entityId": "archive_keeper" }
          },
          "initial": {
            "displayName": "档案管理员",
            "role": "archive-keeper"
          }
        },
        {
          "templateId": "loom.example.character.identity",
          "templateVersion": 1,
          "componentKey": "identity",
          "target": {
            "kind": "entity",
            "entity": { "typeId": "character", "entityId": "night_conductor" }
          },
          "initial": {
            "displayName": "夜班车长",
            "role": "conductor"
          }
        },
        {
          "templateId": "loom.example.character.vitals",
          "templateVersion": 1,
          "componentKey": "vitals",
          "target": { "kind": "entity-type", "typeId": "character" }
        },
        {
          "templateId": "loom.example.character.inventory",
          "templateVersion": 1,
          "componentKey": "inventory",
          "target": {
            "kind": "entity",
            "entity": { "typeId": "character", "entityId": "archive_keeper" }
          },
          "initial": {
            "items": [{ "typeId": "item", "entityId": "rainline-key" }]
          }
        },
        {
          "templateId": "loom.example.item.identity",
          "templateVersion": 1,
          "componentKey": "identity",
          "target": {
            "kind": "entity",
            "entity": { "typeId": "item", "entityId": "rainline-key" }
          },
          "initial": {
            "displayName": "雨线钥匙",
            "description": "能够开启雨线车站档案库的旧铜钥匙。"
          }
        }
      ],
      "bindings": []
    }
  },
  "stateTemplates": [
    {
      "id": "loom.example.character.identity",
      "templateVersion": 1,
      "label": "角色身份",
      "schema": {
        "type": "object",
        "properties": {
          "displayName": { "type": "string" },
          "role": { "type": "string" },
          "present": { "type": "boolean" }
        },
        "required": ["displayName", "role", "present"],
        "additionalProperties": false
      },
      "initial": {
        "displayName": "Unknown Character",
        "role": "visitor",
        "present": true
      }
    },
    {
      "id": "loom.example.character.vitals",
      "templateVersion": 1,
      "label": "生命状态",
      "schema": {
        "type": "object",
        "properties": {
          "hp": { "type": "number", "minimum": 0 },
          "maxHp": { "type": "number", "minimum": 1 },
          "status": { "type": "string" }
        },
        "required": ["hp", "maxHp", "status"],
        "additionalProperties": false
      },
      "initial": {
        "hp": 100,
        "maxHp": 100,
        "status": "healthy"
      }
    }
  ],
  "timelineStateBindings": [
    {
      "path": "entities.characters.archive_keeper.components.identity",
      "templateId": "loom.example.character.identity",
      "templateVersion": 1,
      "initial": {
        "displayName": "档案管理员",
        "role": "archive-keeper"
      }
    },
    {
      "path": "entities.characters.night_conductor.components.identity",
      "templateId": "loom.example.character.identity",
      "templateVersion": 1,
      "initial": {
        "displayName": "夜班车长",
        "role": "conductor"
      }
    },
    {
      "path": "entities.characters.*.components.vitals",
      "templateId": "loom.example.character.vitals",
      "templateVersion": 1
    }
  ],
  "metadata": {
    "kind": "demo-workspace",
    "createdFor": "prompt-builder-and-state-authoring"
  }
}
