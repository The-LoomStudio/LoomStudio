{
  "manifestVersion": 2,
  "id": "official.themes",
  "version": "1.2.0",
  "displayName": "官方主题",
  "icon": "./icon.png",
  "description": "经典配色与极简黑白主题，包含界面及代码高亮颜色；样式增强独立选择。",
  "author": "Loom Studio",
  "engines": {
    "studio": "^0.1.0"
  },
  "modules": [
    {
      "id": "motion",
      "runtime": "client",
      "entry": "./client.js"
    }
  ],
  "contributes": {
    "themes": [
      {
        "id": "catppuccin",
        "label": "Catppuccin Mocha",
        "description": "Studio 原有的紫色强调与暖灰暗色配色，包含状态色和编辑器语法色。",
        "css": "./catppuccin.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#1e1e2e",
          "#313244",
          "#cba6f7"
        ]
      },
      {
        "id": "indigo-dark",
        "label": "靛蓝深色",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./indigo-dark.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#282a2e",
          "#1e1f22",
          "#5865f2"
        ]
      },
      {
        "id": "indigo-light",
        "label": "靛蓝浅色",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./indigo-light.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#f7f8fb",
          "#ffffff",
          "#5865f2"
        ]
      },
      {
        "id": "warm-orange",
        "label": "暖灰陶橙",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./warm-orange.css",
        "nativeMotion": "retain",
        "previewColors": [
          "oklch(0.2679 0.0036 106.6427)",
          "oklch(0.2679 0.0036 106.6427)",
          "oklch(0.6724 0.1308 38.7559)"
        ]
      },
      {
        "id": "nord",
        "label": "Nord",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./nord.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#2e3440",
          "#3b4252",
          "#88c0d0"
        ]
      },
      {
        "id": "everforest",
        "label": "Everforest",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./everforest.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#2d353b",
          "#343f44",
          "#a7c080"
        ]
      },
      {
        "id": "yozakura-night",
        "label": "Yozakura Night",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./yozakura-night.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#14101f",
          "#1e172e",
          "#db7cf0"
        ]
      },
      {
        "id": "tokyo-night",
        "label": "Tokyo Night",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./tokyo-night.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#1a1b26",
          "#24283b",
          "#7aa2f7"
        ]
      },
      {
        "id": "black-blue",
        "label": "曜黑亮蓝",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./black-blue.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#000000",
          "#000000",
          "#1d9bf0"
        ]
      },
      {
        "id": "mono-dark",
        "label": "极简黑",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./mono-dark.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#09090b",
          "#18181b",
          "#fafafa"
        ]
      },
      {
        "id": "mono-light",
        "label": "极简白",
        "description": "界面与代码高亮配色；保留当前布局、字体和材质。",
        "css": "./mono-light.css",
        "nativeMotion": "retain",
        "previewColors": [
          "#ffffff",
          "#fafafa",
          "#18181b"
        ]
      }
    ],
    "styles": [
      {
        "id": "smooth-motion",
        "label": "轻动效",
        "description": "替换原生装饰动效；CSS 模式提供按钮反馈，授权代码后增加面板进入与退出动画。",
        "css": "./motion.css",
        "moduleId": "motion",
        "supportsCssOnly": true,
        "nativeMotion": "disable"
      },
      {
        "id": "mint",
        "label": "薄荷强调色",
        "css": "./mint.css"
      },
      {
        "id": "amber",
        "label": "琥珀强调色",
        "css": "./amber.css"
      }
    ]
  }
}
