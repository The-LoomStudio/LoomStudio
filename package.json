{
  "name": "loom-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm run build:packages && tsc -b",
    "build:packages": "pnpm --filter @loom/core build && tsc -b tsconfig.packages.json",
    "dev:packages": "tsc -b tsconfig.packages.json --watch --preserveWatchOutput",
    "check:docs": "pnpm run check:docs:links && pnpm run check:docs:lifecycle",
    "check:docs:links": "node scripts/check-doc-links.mjs",
    "check:docs:lifecycle": "node scripts/check-doc-lifecycle.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "test": "vitest run",
    "test:probes": "LOOM_TEST_SCOPE=probes vitest run",
    "verify:server-extension": "pnpm --filter @loom-studio/weather-station-test-extension build && tsx scripts/verify-server-extension.ts",
    "verify:server-extension-manager": "pnpm --filter @loom-studio/example-echo build && tsx scripts/verify-server-extension-manager.ts",
    "measure:prompt-resource-storage": "tsx scripts/measure-prompt-resource-storage.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:server": "node scripts/dev-with-packages.mjs server",
    "dev:client": "node scripts/dev-with-packages.mjs client",
    "playground": "pnpm --filter @loom-studio/playground start"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "clsx": "2.1.1",
    "eslint": "10.6.0",
    "fflate": "0.8.3",
    "prettier": "3.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.1",
    "vitest": "4.1.9",
    "ws": "8.21.0",
    "zod": "4.4.3",
    "semver": "7.8.5"
  }
}
