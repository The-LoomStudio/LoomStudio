{
  "name": "loom-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.22.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm run build:packages && tsc -b",
    "build:app": "pnpm run build:packages && pnpm --filter @loom-studio/story-memory build && pnpm --filter @loom-studio/studio-server build && pnpm --filter @loom-studio/studio-client build",
    "release:prepare": "node scripts/release/prepare-release.mjs",
    "release:smoke": "node scripts/release/smoke-release.mjs",
    "start": "node scripts/start.mjs",
    "build:packages": "tsc -b tsconfig.packages.json && pnpm --filter @loom-studio/ui build",
    "dev:packages": "tsc -b tsconfig.packages.json --watch --preserveWatchOutput",
    "check:docs": "node scripts/checks/check-docs.mjs",
    "check:docs:links": "node scripts/checks/check-doc-links.mjs",
    "check:docs:lifecycle": "node scripts/checks/check-doc-lifecycle.mjs",
    "check:workspace": "node scripts/checks/check-workspace.mjs",
    "check:types": "tsc -b && tsc -p tests/tsconfig.json --incremental false",
    "check:all": "pnpm check:workspace && pnpm check:types",
    "audit:unused": "knip",
    "analyze:client": "LOOM_ANALYZE_BUNDLE=1 pnpm --filter @loom-studio/studio-client build",
    "benchmark:context-assets": "node --expose-gc --import tsx scripts/dev/benchmark-context-assets.ts",
    "size:client": "pnpm --filter @loom-studio/studio-client build && size-limit",
    "resource:author": "tsx scripts/dev/resource-authoring.ts",
    "extension:author-build": "tsx scripts/pack/build-extension-authoring.ts",
    "official:pack": "tsx scripts/pack/pack-official-content.ts",
    "example:character-status": "tsx scripts/pack/pack-character-status-example.ts",
    "test": "vitest run",
    "test:typecheck": "tsc -p tests/tsconfig.json --incremental false",
    "test:extensions": "LOOM_TEST_SCOPE=extensions vitest run",
    "test:extensions:typecheck": "tsc -p tests/extensions/tsconfig.json --incremental false",
    "test:fast": "LOOM_TEST_SCOPE=fast vitest run",
    "test:server": "LOOM_TEST_SCOPE=server vitest run",
    "test:client": "LOOM_TEST_SCOPE=client vitest run",
    "test:real": "LOOM_TEST_SCOPE=real vitest run",
    "test:stress": "LOOM_TEST_SCOPE=stress vitest run",
    "test:probes": "LOOM_TEST_SCOPE=probes vitest run",
    "verify:server-extension": "pnpm --filter @loom-studio/weather-station-test-extension build && tsx scripts/dev/verify-server-extension.ts",
    "measure:prompt-resource-storage": "tsx scripts/dev/measure-prompt-resource-storage.ts",
    "refactor:migrate-imports": "tsx scripts/dev/migrate-imports.ts",
    "data:reset": "tsx scripts/data/reset-dev-data.ts",
    "lint": "oxlint . --ignore-pattern \"official/extensions/**\"",
    "dev:server": "node scripts/dev/dev-with-packages.mjs server",
    "dev:server:lan": "node scripts/dev/dev-with-packages.mjs server --lan",
    "dev:client": "node scripts/dev/dev-with-packages.mjs client",
    "dev:client:lan": "node scripts/dev/dev-with-packages.mjs client --lan",
    "preview:client": "pnpm --filter @loom-studio/studio-client build && pnpm --filter @loom-studio/studio-client exec vite preview --config vite.config.ts --host 127.0.0.1 --port 18013 --strictPort",
    "preview:client:lan": "pnpm --filter @loom-studio/studio-client build && pnpm --filter @loom-studio/studio-client exec vite preview --config vite.config.ts --host 0.0.0.0 --port 18013 --strictPort",
    "playground": "pnpm --filter @loom-studio/playground start"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@codemirror/state": "6.7.2",
    "@rolldown/plugin-babel": "0.2.4",
    "@size-limit/file": "13.1.1",
    "@tanstack/react-query": "5.102.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "fast-check": "4.10.0",
    "fflate": "0.8.3",
    "happy-dom": "20.14.6",
    "knip": "6.35.1",
    "mitata": "1.0.34",
    "oxlint": "1.88.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.2",
    "rollup-plugin-visualizer": "7.1.1",
    "semver": "7.8.5",
    "size-limit": "13.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "patchedDependencies": {
      "sonner@2.0.7": "patches/sonner@2.0.7.patch",
      "@codemirror/merge@6.12.2": "patches/@codemirror__merge@6.12.2.patch"
    }
  }
}
