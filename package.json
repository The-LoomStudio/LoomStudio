{
  "name": "loom-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm run build:packages && tsc -b",
    "build:packages": "pnpm --filter @loom/core build && tsc -b tsconfig.packages.json",
    "dev:packages": "tsc -b tsconfig.packages.json --watch --preserveWatchOutput",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:links": "node scripts/check-doc-links.mjs",
    "check:docs:lifecycle": "node scripts/check-doc-lifecycle.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "audit:unused": "knip",
    "analyze:client": "LOOM_ANALYZE_BUNDLE=1 pnpm --filter @loom-studio/studio-client build",
    "benchmark:context-assets": "node --expose-gc --import tsx scripts/benchmark-context-assets.ts",
    "size:client": "pnpm --filter @loom-studio/studio-client build && size-limit",
    "official:pack": "tsx scripts/pack-official-content.ts",
    "example:character-status": "tsx scripts/pack-character-status-example.ts",
    "data:migrate": "tsx scripts/migrate-data-directory.ts",
    "test": "vitest run",
    "test:fast": "LOOM_TEST_SCOPE=fast vitest run",
    "test:server": "LOOM_TEST_SCOPE=server vitest run",
    "test:real": "LOOM_TEST_SCOPE=real vitest run",
    "test:stress": "LOOM_TEST_SCOPE=stress vitest run",
    "test:probes": "LOOM_TEST_SCOPE=probes vitest run",
    "verify:server-extension": "pnpm --filter @loom-studio/weather-station-test-extension build && tsx scripts/verify-server-extension.ts",
    "verify:server-extension-manager": "pnpm --filter @loom-studio/example-echo build && tsx scripts/verify-server-extension-manager.ts",
    "measure:prompt-resource-storage": "tsx scripts/measure-prompt-resource-storage.ts",
    "lint": "eslint .",
    "dev:server": "node scripts/dev-with-packages.mjs server",
    "dev:client": "node scripts/dev-with-packages.mjs client",
    "playground": "pnpm --filter @loom-studio/playground start"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@codemirror/state": "6.7.2",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@size-limit/file": "13.1.1",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.0",
    "fflate": "0.8.3",
    "knip": "6.35.1",
    "mitata": "1.0.34",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rollup-plugin-visualizer": "7.1.1",
    "semver": "7.8.5",
    "size-limit": "13.1.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
